# Optional local configuration. Copy to .env and edit if needed.
STOCK_RESEARCH_AI_DATABASE_PATH=~/.stock-research-ai/research.sqlite3
STOCK_RESEARCH_AI_HTTP_HOST=127.0.0.1
STOCK_RESEARCH_AI_HTTP_PORT=8000

# Optional; defaults to an artifacts/ sibling of the selected SQLite database.
# STOCK_RESEARCH_AI_ARTIFACT_PATH=~/.stock-research-ai/artifacts

# Optional personal Kite market acquisition; never commit actual values.
KITE_API_KEY=
KITE_ACCESS_TOKEN=
