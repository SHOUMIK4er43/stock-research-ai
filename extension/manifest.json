{
  "manifest_version": 3,
  "name": "Stock Research AI",
  "version": "0.1.0",
  "description": "Institutional-grade equity research for a supported Screener company page, run entirely by your local Stock Research AI service.",
  "action": {},
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://www.screener.in/*", "http://127.0.0.1/*"]
}
